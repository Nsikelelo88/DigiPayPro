@model IEnumerable<DigitalPayPro.Models.Employee>

@* Set the page title *@
@{
    ViewData["Title"] = "Employees";
}

@* Header with page title and "Add New Employee" button *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> Add New Employee
    </a>
</div>

@* Display success message if available *@
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* Display error message if available *@
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* Main card containing the employee table *@
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            @* Employee data table *@
            <table class="table table-striped table-hover" id="employeesTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>ID Number</th>
                        <th>Position</th>
                        <th>Basic Salary</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Date Joined</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @* Loop through each employee and display their details *@
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FirstName @item.LastName</td>
                            <td>@item.IDNumber</td>
                            <td>@item.Position</td>
                            <td>R @item.BasicSalary.ToString("N2")</td>
                            <td>@item.Email</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.DateJoined.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge bg-@(item.IsActive ? "success" : "secondary")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                @* Action buttons: View, Edit, Delete *@
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this employee?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize DataTable for enhanced table features (search, sort, pagination)
        $(document).ready(function() {
            // Check if DataTable is already initialized
            if ($.fn.DataTable.isDataTable('#employeesTable')) {
                $('#employeesTable').DataTable().destroy();
            }

            // Initialize DataTable
            $('#employeesTable').DataTable({
                responsive: true,
                ordering: true,
                searching: true,
                pageLength: 10,
                destroy: true, // Allow reinitialization
                retrieve: true // Try to retrieve an existing DataTable instance
            });
        });
    </script>
}