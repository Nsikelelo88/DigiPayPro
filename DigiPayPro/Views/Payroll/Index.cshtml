@model IEnumerable<DigitalPayPro.Models.PayrollRecord>

@{
    ViewData["Title"] = "Payroll Records";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <div>
        <a asp-action="Process" class="btn btn-primary me-2">
            <i class="fas fa-calculator me-1"></i> Process Payroll
        </a>
        <a asp-action="PeriodReport" class="btn btn-info">
            <i class="fas fa-chart-bar me-1"></i> View Reports
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover" id="payrollTable">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Pay Period</th>
                        <th>Basic Pay</th>
                        <th>Overtime</th>
                        <th>Incentives</th>
                        <th>Gross Pay</th>
                        <th>Deductions</th>
                        <th>Net Pay</th>
                        <th>Date Processed</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Employee?.FirstName @item.Employee?.LastName</td>
                            <td>@item.PayPeriod.ToString("MMM yyyy")</td>
                            <td>R @item.BasicPay.ToString("N2")</td>
                            <td>@item.OvertimeHours hrs (R @item.OvertimePay.ToString("N2"))</td>
                            <td>R @item.Incentives.ToString("N2")</td>
                            <td>R @item.GrossPay.ToString("N2")</td>
                            <td>R @item.TotalDeductions.ToString("N2")</td>
                            <td><strong>R @item.NetPay.ToString("N2")</strong></td>
                            <td>@item.DateProcessed.ToString("yyyy-MM-dd")</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="View Details">
                                        <i class="fas fa-eye"></i> Details
                                    </a>
                                    <a asp-action="GeneratePayslip" asp-route-id="@item.Id" class="btn btn-sm btn-success" title="Download Payslip">
                                        <i class="fas fa-download"></i> PDF
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Check if DataTable is already initialized
            if ($.fn.DataTable.isDataTable('#payrollTable')) {
                $('#payrollTable').DataTable().destroy();
            }

            // Initialize DataTable
            $('#payrollTable').DataTable({
                responsive: true,
                ordering: true,
                searching: true,
                pageLength: 10,
                order: [[1, 'desc']], // Sort by Pay Period descending
                destroy: true,
                retrieve: true,
                language: {
                    search: "Search records:",
                    lengthMenu: "Show _MENU_ records per page",
                    info: "Showing _START_ to _END_ of _TOTAL_ records",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    }
                }
            });
        });
    </script>
}